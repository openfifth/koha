# Koha instance __KOHASITE__ Hypnotoad Intranet conf

{
    hypnotoad => {

        # Maximum number of connections a worker is allowed to accept before stopping
        # gracefully and then getting replaced with a newly started worker
        # Default: 10000
        accepts => 10000,

        # Listen backlog size
        # Default: 128
        backlog => 128,

        # Maximum number of accepted connections each worker process is allowed
        # to handle concurrently
        # Default: 1000
        clients => 1000,

        # Maximum amount of time in seconds stopping a worker gracefully may
        # take before being forced
        # Default: 120
        graceful_timeout => 120,

        # Heartbeat interval in seconds
        # Default: 5
        heartbeat_interval => 5,

        # Maximum amount of time in seconds before a worker without a heartbeat
        # will be stopped gracefully
        # Default: 50
        heartbeat_timeout => 50,

        # Maximum amount of time in seconds a connection with an active request
        # can be inactive before getting closed
        # Default: 30
        inactivity_timeout => 30,

        # Maximum amount of time in seconds a connection without an active
        # request can be inactive before getting closed
        # Default: 10
        keep_alive_timeout => 10,

        # Array reference with one or more locations to listen on
        # See https://metacpan.org/pod/Mojo::Server::Daemon#listen for examples
        #
        # Default: ['http://*:__INTRAPORT__']
        listen => [
            'http://*:__INTRAPORT__',
        ],

        # Full path to process id file
        # Default: '/var/run/koha/__KOHASITE__/mojo-intranet.pid'
        pid_file => '/var/run/koha/__KOHASITE__/mojo-intranet.pid',

        # Activate reverse proxy support, which allows for the X-Forwarded-For
        # and X-Forwarded-Proto headers to be picked up automatically
        # Default: 1
        proxy => 1,

        # Number of keep-alive requests per connection
        # Default: 100
        requests => 100,

        # Temporarily spawn up to this number of additional workers if there is
        # a need
        # Default: 2
        spare => 2,

        # This server expects requests from trusted reverse proxies These
        # proxies should be addresses or networks in CIDR form.
        #
        # Default:[ '127.0.0.0/8', '::1/128' ]
        trusted_proxies => [
            '127.0.0.0/8',
            '::1/128',
        ],

        # Maximum amount of time in seconds a zero downtime software upgrade may
        # take before getting canceled
        # Default: 180
        upgrade_timeout => 180,

        # Number of worker processes to spawn
        # Default: 4
        workers => 4,
    }
};
