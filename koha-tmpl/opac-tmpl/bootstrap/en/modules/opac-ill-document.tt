[% USE raw %]
[% USE Koha %]
[% USE AdditionalContents %]
[% PROCESS 'i18n.inc' %]
[% PROCESS 'html_helpers.inc' %]
[% SET OpacNav = AdditionalContents.get( location => "OpacNav", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% SET OpacNavBottom = AdditionalContents.get( location => "OpacNavBottom", lang => lang, library => logged_in_user.branchcode || default_branch, blocktitle => 0 ) %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
        <span>Interlibrary loan document</span> &rsaquo; [% PROCESS 'library_name_title' %]
    [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
[% BLOCK cssinclude %]
[% END %]
</head>
[% INCLUDE 'bodytag.inc' bodyid='opac-ill-document' %]
[% INCLUDE 'masthead.inc' %]

<main class="main">
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            <span>Interlibrary loan document</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]

    <div class="container-fluid">
        <div class="row">
            [% IF ( OpacNav ||  OpacNavBottom ) %]
                <div class="col-12 col-lg-2 order-3 order-lg-1">
                    <div id="navigation"> [% INCLUDE 'navigation.inc' %] </div>
                </div>
            [% END %]

            [% SET column_class = "col order-md-1 maincontent" %]
            [% IF ( OpacNav ||  OpacNavBottom  ) %]
                [% column_class = "col-12 col-lg-10 order-md-1 maincontent" %]
            [% END %]
            <div class="[% column_class | html %]">
                <div id="ill-document">
                    <h1>Interlibrary loan document</h1>
                    [% IF document %]
                        <p>Your document <strong>[% document.file_name | html %]</strong> is ready.</p>
                        <form action="/cgi-bin/koha/opac-ill-document.pl" method="post" id="ill-document-download">
                            [% INCLUDE 'csrf-token.inc' %]
                            <input type="hidden" name="token" value="[% token | html %]" />
                            <input type="hidden" name="op" value="cud-download" />
                            <button type="submit" class="btn btn-primary"><i class="fa fa-download" aria-hidden="true"></i> Download</button>
                        </form>
                    [% ELSE %]
                        <div class="alert alert-warning">This document link is not valid, or the document is no longer available.</div>
                    [% END %]
                </div>
            </div>
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</main>
<!-- /.main -->

[% INCLUDE 'opac-bottom.inc' %]
[% BLOCK jsinclude %]
[% END %]
