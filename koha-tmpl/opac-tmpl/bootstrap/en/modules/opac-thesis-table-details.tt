[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% USE KohaDates %]
[% USE AuthorisedValues %]
[% USE ItemTypes %]
[% USE Branches %]
[% USE TablesSettings %]
[% PROCESS 'i18n.inc' %]
[% PROCESS 'html_helpers.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
        [%- IF course.section -%][% tx("Reserves for '{course_name}' - {section}", { course_name = course.course_name, section = course.section }) | html %][%- ELSE -%][% tx("Reserves for '{course_name}'", { course_name = course.course_name }) | html %][%- END -%]
        &rsaquo; [% PROCESS 'library_name_title' %]
    [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
[% BLOCK cssinclude %]
[% END %]

</head>
[% INCLUDE 'bodytag.inc' bodyid='opac-course-details' %]
[% INCLUDE 'masthead.inc' %]

<main class="main">
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/opac-thesis-tables.pl">[% course_type_display | html %]</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            [%- IF course.section -%][% tx("Reserves for '{course_name}' - {section}", { course_name = course.course_name, section = course.section }) | html %][%- ELSE -%][% tx("Reserves for '{course_name}'", { course_name = course.course_name }) | html %][%- END -%]
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]

    <div class="container-fluid">
        <div class="row">
            <div class="col">
                <div id="thesis_tables" class="maincontent">
                    <h1
                        >[%- IF course.section -%][% tx("Reserves for '{course_name}' - {section}", { course_name = course.course_name, section = course.section }) | html %][%- ELSE -%][% tx("Reserves for '{course_name}'", { course_name = course.course_name }) | html %][%- END -%]</h1
                    >
                    <div class="rows">
                        <ol>
                            [% IF ( course.instructors ) %]
                                <li
                                    ><span class="label">Researcher:</span>
                                    <ul>
                                        [% FOREACH i IN course.instructors %]
                                            <li><div class="instructor">[% i.firstname | html %] [% i.surname | html %]</div></li>
                                        [% END %]
                                    </ul>
                                </li>
                            [% END %]
                            [% IF ( course.public_note ) %]<li><span class="label">Notes:</span> [% course.public_note | $raw %]</li>[% END %]
                        </ol>
                    </div>

                    [% IF ( course_reserves ) %]
                        <table id="thesis-table-items-table" class="table table-bordered table-striped table-condensed">
                            <caption class="sr-only">[% course_type_display | html %]</caption>
                            <thead>
                                <tr>
                                    <th class="anti-the">Title</th>
                                    <th>Author</th>
                                    <th>Item type</th>
                                    <th>Location</th>
                                    <th>Collection</th>
                                    <th>Call number</th>
                                    <th>Copy number</th>
                                    <th>Status</th>
                                    <th>Date due</th>
                                    <th>Notes</th>
                                    <th>Link</th>
                                    <th class="dtr-control-col"></th>
                                </tr>
                            </thead>

                            <tbody>
                                [% FOREACH cr IN course_reserves %]
                                    <tr>
                                        <td><a href="opac-detail.pl?biblionumber=[% cr.biblio.biblionumber | uri %]">[% INCLUDE 'biblio-title-head.inc' biblio=cr.biblio %]</a></td>
                                        <td>[% cr.biblio.author | html %]</td>
                                        <td>[% ItemTypes.GetDescription( cr.item.itype ) | html %]</td>
                                        <td
                                            >[% Branches.GetName( cr.item.holdingbranch ) | html %] <br />
                                            <em>[% AuthorisedValues.GetDescriptionByKohaField( kohafield => 'items.location', authorised_value => cr.item.location, opac => 1 ) | html %]</em></td
                                        >
                                        <td>[% AuthorisedValues.GetDescriptionByKohaField( kohafield => 'items.ccode', authorised_value => cr.item.ccode, opac => 1 ) | html %]</td>
                                        <td>[% cr.item.itemcallnumber | html %]</td>
                                        <td>[% cr.item.copynumber | html %]</td>
                                        <td>[% INCLUDE 'item-status.inc' item=cr.item issue=cr.issue %]</td>
                                        <td><span title="[% cr.issue.date_due | html %]">[% cr.issue.date_due | $KohaDates  as_due_date => 1 %]</span></td>
                                        <td
                                            >[% IF ( cr.public_note ) %]
                                                [% cr.public_note | $raw %]
                                            [% ELSIF ( cr.item.itemnotes ) %]
                                                [% cr.item.itemnotes | $raw %]
                                            [% END %]
                                        </td>
                                        <td
                                            >[% IF (cr.item.uri) %]
                                                <a href="[% cr.item.uri | url %]">Item URI</a>
                                            [% ELSIF (cr.biblioitem.url) %]
                                                <a href="[% cr.biblioitem.url | url %]">Record URL</a>
                                            [% END %]
                                        </td>
                                        <td></td>
                                    </tr>
                                [% END %]
                            </tbody>
                        </table>
                    [% ELSE %]
                        <br style="clear:both;" />
                        <div class="alert alert-info">
                            <p>No reserves have been selected for this research table.</p>
                        </div>
                    [% END %]
                </div>
                <!-- / #course_reserves -->
            </div>
            <!-- / .col -->
        </div>
        <!-- / .row -->
    </div>
    <!-- / .container-fluid -->
</main>
<!-- / .main -->
[% INCLUDE 'opac-bottom.inc' %]
[% BLOCK jsinclude %]
    [% INCLUDE 'datatables.inc' %]
    <script nonce="[% Koha.CSPNonce | $raw %]">
        $(document).ready(function () {
            [% IF ( Koha.Preference('OPACTableColExpandedByDefault') ) %]
                var responsive_display = DataTable.Responsive.display.childRowImmediate;
            [% ELSE %]
                var responsive_display = DataTable.Responsive.display.childRow;
            [% END %]
            table_settings = [% TablesSettings.GetTableSettings( 'opac', 'course_items', 'thesis-table-items-table', 'json' ) | $raw %];
            $("#thesis-table-items-table").kohaTable(
                {
                    dom: '<"top"<"table_controls"f>>rt<"clear">',
                    sorting: [[1, "asc"]],
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: _("Search reserves"),
                    },
                    responsive: {
                        details: {
                            display: responsive_display,
                            type: "column",
                            target: -1,
                        },
                    },
                    columnDefs: [{ className: "dtr-control", orderable: false, targets: -1 }],
                },
                table_settings
            );
        });
    </script>
[% END %]
