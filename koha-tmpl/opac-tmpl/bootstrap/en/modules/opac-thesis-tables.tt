[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% USE AuthorisedValues %]
[% USE TablesSettings %]
[% PROCESS 'i18n.inc' %]
[% PROCESS 'html_helpers.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
[% USE HtmlScrubber %]
<title
    >[% FILTER collapse %]
        [% course_type_display | html %]
        &rsaquo; [% PROCESS 'library_name_title' %]
    [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
[% BLOCK cssinclude %]
[% END %]

</head>
[% INCLUDE 'bodytag.inc' bodyid='opac-thesis-tables' %]
[% INCLUDE 'masthead.inc' %]

<main class="main">
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            <span>[% course_type_display | html %]</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]

    <div class="container-fluid">
        <div class="row">
            <div class="col order-first order-md-first order-lg-2">
                <div id="courses" class="maincontent">
                    <h1>[% course_type_display | html %]</h1>

                    <table id="thesis_tables_table" class="table table-bordered table-striped table-condensed">
                        <caption class="sr-only">[% course_type_display | html %]</caption>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Table #</th>
                                <th>Researcher</th>
                                <th>Topic</th>
                                <th class="dtr-control-col">[% t('Expand') | html %]</th>
                            </tr>
                        </thead>

                        <tbody>
                            [% FOREACH c IN courses %]
                                <tr>
                                    <td><a href="opac-thesis-table-details.pl?table_id=[% c.course_id | uri %]">[% c.course_name | html %][%- IF c.section -%]- [% c.section | html %][%- END -%]</a></td>
                                    <td>[% c.course_number | html %]</td>
                                    <td>
                                        [% FOREACH i IN c.instructors %]
                                            <div class="instructor"
                                                ><span class="inst_surname">[% i.surname | html %]</span>[% IF i.firstname %]<span class="instr_separator">, </span><span class="instr_firstname">[% i.firstname | html %]</span>[% END %]</div
                                            >
                                        [% END %]
                                    </td>
                                    <td>[% c.public_note | $raw %]</td>
                                    <td></td>
                                </tr>
                            [% END %]
                        </tbody>
                    </table>
                </div>
                <!-- / #courses -->
            </div>
            <!-- / .col -->
        </div>
        <!-- / .row -->
    </div>
    <!-- / .container-fluid -->
</main>
<!-- / .main -->
[% INCLUDE 'opac-bottom.inc' %]
[% BLOCK jsinclude %]
    [% INCLUDE 'datatables.inc' %]
    <script nonce="[% Koha.CSPNonce | $raw %]">
        $(document).ready(function () {
            [% IF ( Koha.Preference('OPACTableColExpandedByDefault') ) %]
                var responsive_display = DataTable.Responsive.display.childRowImmediate;
            [% ELSE %]
                var responsive_display = DataTable.Responsive.display.childRow;
            [% END %]
            table_settings = [% TablesSettings.GetTableSettings( 'opac', 'course_list', 'thesis_tables_table', 'json' ) | $raw %]
            $("#thesis_tables_table").kohaTable(
                {
                    dom: '<"top"<"table_controls"f>>rt<"clear">',
                    order: [[1, "asc"]],
                    asColumnDefs: [{ aTargets: [1], sType: "nsb-nse" }],
                    language: {
                        search: "<span class='visually-hidden'>" + _("Search courses") + "</span> _INPUT_",
                        searchPlaceholder: _("Search courses"),
                    },
                    responsive: {
                        details: {
                            display: responsive_display,
                            type: "column",
                            target: -1,
                        },
                    },
                    columnDefs: [{ className: "dtr-control", orderable: false, targets: -1 }],
                },
                table_settings
            );
        });
    </script>
[% END %]
