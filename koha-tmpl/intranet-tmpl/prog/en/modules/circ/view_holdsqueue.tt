[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% USE ItemTypes %]
[% USE Branches %]
[% USE AuthorisedValues %]
[% USE TablesSettings %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
        [% t("Holds queue") | html %]
        &rsaquo; [% t("Circulation") | html %] &rsaquo; [% t("Koha") | html %]
    [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
<style nonce="[% Koha.CSPNonce | $raw %]">
    p {
        margin-top: 0;
    }
    #locationslimit + .select2-container,
    #itemtypeslimit + .select2-container {
        max-width: 300px !important;
    }
    .main .col-md-10 #branchlimit,
    .main .col-md-10 #itemtypeslimit {
        width: 300px;
    }
</style>
</head>

<body id="circ_view_holdsqueue" class="circ">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'circ-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/circ/circulation-home.pl">Circulation</a>
        [% END %]
        [% IF ( run_report ) %]
            [% WRAPPER breadcrumb_item %]
                [% IF Koha.Preference('UseHoldsQueueFilterOptions') %]
                    <a href="/cgi-bin/koha/circ/view_holdsqueue.pl?branchlimit=[% Branches.GetLoggedInBranchcode | uri %]">Holds queue</a>
                [% ELSE %]
                    <a href="/cgi-bin/koha/circ/view_holdsqueue.pl?branchlimit=[% Branches.GetLoggedInBranchcode | uri %]&run_report=1">Holds queue</a>
                [% END %]
            [% END %]
            [% WRAPPER breadcrumb_item bc_active= 1 %]
                <span>Results</span>
            [% END %]
        [% ELSE %]
            [% WRAPPER breadcrumb_item bc_active= 1 %]
                <span>Holds queue</span>
            [% END %]
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

<div class="main container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <main>
                <div class="row">
                    [% IF ( run_report || Koha.Preference('CircSidebar') ) %]
                        [% SET div_class='col-md-10 order-md-2 order-sm-1' %]
                    [% ELSE %]
                        [% SET div_class='col-md-10 offset-md-1 col-lg-8 offset-lg-2' %]
                    [% END %]
                    <div class="[% div_class | html %]">
                        [% INCLUDE 'messages.inc' %]

                        <h1>Holds queue</h1>

                        [% IF ( run_report ) %]
                            <div class="page-section">
                                <table id="holdst">
                                    <thead>
                                        <tr>
                                            <th class="hq-title anti-the">Title</th>
                                            <th class="hq-author">Author</th>
                                            <th class="hq-pubdetails">Publication details</th>
                                            <th class="hq-holdingbranch">Current library</th>
                                            <th class="hq-homebranch">Home library</th>
                                            <th class="hq-collection">Collection</th>
                                            <th class="hq-location">Shelving location</th>
                                            <th class="hq-itemtype">Item type</th>
                                            <th class="hq-callnumber">Call number</th>
                                            <th class="hq-copynumber">Copy number</th>
                                            <th class="hq-enumchron">Enumeration</th>
                                            <th class="hq-barcode">Barcode</th>
                                            <th class="hq-patron">Patron</th>
                                            <th class="hq-patroncategory">Patron category</th>
                                            <th class="hq-sendto">Send to</th>
                                            <th class="hq-date">Date</th>
                                            <th class="hq-notes">Notes</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <!-- /.page-section -->
                        [% END %]

                        [% UNLESS ( run_report ) %]
                            [% PROCESS filter_form %]
                        [% END %]
                    </div>
                    <!-- /.col-md-10.order-md-2 -->
                    [% IF ( run_report || Koha.Preference('CircSidebar') ) %]
                        <div class="col-md-2 order-sm-2 order-md-1">
                            <aside>
                                [% IF ( run_report ) %]
                                    [% PROCESS filter_form %]
                                [% END %]
                                [% IF Koha.Preference('CircSidebar') %]
                                    [% INCLUDE 'circ-nav.inc' %]
                                [% END %]
                            </aside>
                        </div>
                        <!-- /.col-md-2.order-md-1 -->
                    [% END %]
                </div>
                <!-- /.row -->
            </main>
        </div>
        <!-- /.col-sm-12 -->
    </div>
    <!-- /.row -->
</div>
<!-- /.main.container-fluid -->

[% BLOCK filter_form %]
    <form method="get" name="f" action="/cgi-bin/koha/circ/view_holdsqueue.pl">
        [% IF ( run_report ) %]
            [% SET fieldset_class='brief' %]
        [% ELSE -%]
            [% SET fieldset_class='rows' %]
        [% END %]
        <fieldset class="[% fieldset_class | html %]">
            <ol>
                <li>
                    <label for="branchlimit">Library: </label>
                    <select name="branchlimit" id="branchlimit">
                        [% IF CAN_user_superlibrarian || !Koha.Preference('IndependentBranches') %]
                            <option value="">All</option>
                        [% END %]
                        [% PROCESS options_for_libraries libraries => Branches.all( selected => branchlimit, only_from_group => 1 ) %]
                    </select>
                </li>
                <li>
                    <label for="itemtypeslimit">Item type: </label>
                    <select name="itemtypeslimit" id="itemtypeslimit">
                        <option value="">All</option>
                        [% PROCESS options_for_item_types itemtypes => ItemTypes.Get(), selected_itemtype => itemtypeslimit %]
                    </select>
                </li>
                <li>
                    <label for="ccodeslimit">Collection: </label>
                    <select name="ccodeslimit" id="ccodeslimit" multiple="multiple">
                        <option value="">All</option>
                        [% PROCESS options_for_authorised_values_multiselect authorised_values => AuthorisedValues.GetAuthValueDropbox( 'CCODE' ), selected_av => ccodeslimit %]
                    </select>
                </li>
                <li>
                    <label for="locationslimit">Shelving location: </label>
                    <select name="locationslimit" id="locationslimit" multiple="multiple">
                        <option value="">All</option>
                        [% PROCESS options_for_authorised_values_multiselect authorised_values => AuthorisedValues.GetAuthValueDropbox( 'LOC' ), selected_av => locationslimit %]
                    </select>
                </li>
            </ol>
            <fieldset class="action">
                <input type="submit" class="btn btn-primary" value="Submit" />
                <input type="button" id="clear_filters" class="btn btn-default" value="Clear" />
                <input type="hidden" name="run_report" value="1" />
            </fieldset>
        </fieldset>
    </form>
[% END %]

[% INCLUDE 'hold-group-modal.inc' %]

[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'select2.inc' %]
    [% INCLUDE 'datatables.inc' %]
    [% INCLUDE 'js-date-format.inc' %]
    [% Asset.js("js/hold-group.js") | $raw %]
    <script nonce="[% Koha.CSPNonce | $raw %]">
        var table_settings = [% TablesSettings.GetTableSettings('circ', 'view_holdsqueue', 'holds-table', 'json') | $raw %];
        $(document).ready(function () {
            // Apply select2 to all select fields having a "multiple" attribute
            let selectFields = document.querySelectorAll("select[multiple]");
            selectFields.forEach(selectField => {
                $(selectField).select2({
                    width: "100%",
                    allowClear: true,
                });
            });

            [% IF run_report %]
            var additional_filters = {
                "me.holding_library_id": function () {
                    let val = $("#branchlimit").val();
                    if (!val) return "";
                    return { "=": val };
                },
                "item.item_type_id": function () {
                    let val = $("#itemtypeslimit").val();
                    if (!val) return "";
                    return { "=": val };
                },
                "item.collection_code": function () {
                    let vals = $("#ccodeslimit").val();
                    if (!vals || !vals.length || (vals.length === 1 && vals[0] === "")) return "";
                    return vals;
                },
                "item.location": function () {
                    let vals = $("#locationslimit").val();
                    if (!vals || !vals.length || (vals.length === 1 && vals[0] === "")) return "";
                    return vals;
                },
            };

            var holdst = $("#holdst").kohaTable(
                {
                    ajax: {
                        url: "/api/v1/holds/queue",
                    },
                    embed: [
                        "+strings",
                        "biblio",
                        "item+strings",
                        "patron+strings",
                        "patron.notice_email_address",
                    ],
                    order: [[0, "asc"]],
                    columnDefs: [{ defaultContent: "", targets: "_all" }],
                    columns: [
                        {
                            data: "biblio.title",
                            orderable: true,
                            searchable: true,
                            render: function (data, type, row) {
                                let html = "";
                                if (row.biblio) {
                                    html = '<p><a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=' + row.biblio_id + '">' + (row.biblio.title || "").escapeHtml() + "</a></p>";
                                }
                                if (row.hold_group_id) {
                                    html += '<p>(<a class="hold-group" href="/cgi-bin/koha/reserve/hold-group.pl?hold_group_id=' + row.hold_group_id + '">' + _("Hold group") + " " + row.hold_group_id + "</a>)</p>";
                                }
                                return html;
                            },
                        },
                        {
                            data: "biblio.author",
                            orderable: true,
                            searchable: true,
                            render: function (data, type, row) {
                                return row.biblio ? (row.biblio.author || "").escapeHtml() : "";
                            },
                        },
                        {
                            data: "biblio.publisher",
                            orderable: true,
                            searchable: true,
                            render: function (data, type, row) {
                                if (!row.biblio) return "";
                                let parts = [];
                                if (row.biblio.edition_statement) parts.push(row.biblio.edition_statement.escapeHtml());
                                if (row.biblio.publisher) parts.push(row.biblio.publisher.escapeHtml());
                                if (row.biblio.publication_year) parts.push(row.biblio.publication_year);
                                return parts.join(", ");
                            },
                        },
                        {
                            data: "item.holding_library_id",
                            orderable: true,
                            searchable: true,
                            render: function (data, type, row) {
                                if (!row.item) return "";
                                if (row.item._strings && row.item._strings.holding_library_id) {
                                    return (row.item._strings.holding_library_id.str || "").escapeHtml();
                                }
                                return (row.item.holding_library_id || "").escapeHtml();
                            },
                        },
                        {
                            data: "item.home_library_id",
                            orderable: true,
                            searchable: true,
                            render: function (data, type, row) {
                                if (!row.item) return "";
                                if (row.item._strings && row.item._strings.home_library_id) {
                                    return (row.item._strings.home_library_id.str || "").escapeHtml();
                                }
                                return (row.item.home_library_id || "").escapeHtml();
                            },
                        },
                        {
                            data: "item.collection_code",
                            orderable: true,
                            searchable: true,
                            render: function (data, type, row) {
                                if (!row.item) return "";
                                if (row.item._strings && row.item._strings.collection_code) {
                                    return (row.item._strings.collection_code.str || "").escapeHtml();
                                }
                                return (row.item.collection_code || "").escapeHtml();
                            },
                        },
                        {
                            data: "item.location",
                            orderable: true,
                            searchable: true,
                            render: function (data, type, row) {
                                if (!row.item) return "";
                                if (row.item._strings && row.item._strings.location) {
                                    return (row.item._strings.location.str || "").escapeHtml();
                                }
                                return (row.item.location || "").escapeHtml();
                            },
                        },
                        {
                            data: "item.item_type_id",
                            orderable: true,
                            searchable: true,
                            render: function (data, type, row) {
                                if (!row.item) return "";
                                if (row.item._strings && row.item._strings.item_type_id) {
                                    return (row.item._strings.item_type_id.str || "").escapeHtml();
                                }
                                return (row.item.item_type_id || "").escapeHtml();
                            },
                        },
                        {
                            data: "callnumber",
                            orderable: true,
                            searchable: true,
                            render: function (data) {
                                return (data || "").escapeHtml();
                            },
                        },
                        {
                            data: "item.copy_number",
                            orderable: true,
                            searchable: false,
                            render: function (data, type, row) {
                                return row.item ? (row.item.copy_number || "").escapeHtml() : "";
                            },
                        },
                        {
                            data: "item.serial_issue_number",
                            orderable: true,
                            searchable: false,
                            render: function (data, type, row) {
                                return row.item ? (row.item.serial_issue_number || "").escapeHtml() : "";
                            },
                        },
                        {
                            data: "barcode",
                            orderable: true,
                            searchable: true,
                            render: function (data, type, row) {
                                let link = '<strong><a href="/cgi-bin/koha/catalogue/moredetail.pl?itemnumber=' + row.item_id + '&biblionumber=' + row.biblio_id + '#item' + row.item_id + '">' + (data || "").escapeHtml() + "</a></strong>";
                                if (row.item_level) {
                                    return _("Only item:") + " " + link;
                                }
                                return link + " <em>" + _("or any available") + "</em>";
                            },
                        },
                        {
                            data: "patron.surname",
                            orderable: true,
                            searchable: true,
                            render: function (data, type, row) {
                                if (!row.patron) return "";
                                let html = '<p><a href="/cgi-bin/koha/circ/circulation.pl?borrowernumber=' + row.patron.patron_id + '">' + (row.patron.surname || "").escapeHtml() + ", " + (row.patron.firstname || "").escapeHtml() + "</a></p>";
                                if (row.patron.phone) {
                                    html += "<p>" + row.patron.phone.escapeHtml() + "</p>";
                                }
                                if (row.patron.notice_email_address) {
                                    html += '<p class="patron-email"><a href="mailto:' + encodeURIComponent(row.patron.notice_email_address) + '">' + row.patron.notice_email_address.escapeHtml() + "</a></p>";
                                }
                                return html;
                            },
                        },
                        {
                            data: "patron.category_id",
                            orderable: true,
                            searchable: true,
                            render: function (data, type, row) {
                                if (!row.patron) return "";
                                if (row.patron._strings && row.patron._strings.category_id) {
                                    return (row.patron._strings.category_id.str || "").escapeHtml() + " (" + (row.patron.category_id || "").escapeHtml() + ")";
                                }
                                return (row.patron.category_id || "").escapeHtml();
                            },
                        },
                        {
                            data: "pickup_library_id",
                            orderable: true,
                            searchable: true,
                            render: function (data, type, row) {
                                if (row._strings && row._strings.pickup_library_id) {
                                    return (row._strings.pickup_library_id.str || "").escapeHtml();
                                }
                                return (data || "").escapeHtml();
                            },
                        },
                        {
                            data: "hold_date",
                            orderable: true,
                            searchable: false,
                            render: function (data) {
                                return $date(data);
                            },
                        },
                        {
                            data: "notes",
                            orderable: false,
                            searchable: true,
                            render: function (data) {
                                return (data || "").escapeHtml();
                            },
                        },
                    ],
                },
                table_settings,
                null,
                additional_filters,
            );

            // Intercept form submit to redraw table instead of page reload
            $("form[name='f']").on("submit", function (e) {
                e.preventDefault();
                holdst.DataTable().draw();
            });

            // Clear all filters and redraw
            $("#clear_filters").on("click", function () {
                $("#branchlimit").val("");
                $("#itemtypeslimit").val("");
                $("#ccodeslimit").val([]).trigger("change");
                $("#locationslimit").val([]).trigger("change");
                holdst.DataTable().draw();
            });
            [% END %]
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
