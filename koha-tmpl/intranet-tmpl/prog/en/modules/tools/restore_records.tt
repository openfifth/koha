[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% USE KohaDates %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% FILTER collapse %]
    [% t("Restore records") | html %]
    &rsaquo; [% t("Tools") | html %] &rsaquo; [% t("Koha") | html %]
[% END %]</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="tools_restore_records" class="tools">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'cat-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/tools/tools-home.pl">Tools</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            <span>Restore records</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' aside='tools-menu' %]
    <h1>Restore records</h1>

    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">Restore bibliographic records</h3>
                </div>
                <div class="panel-body">
                    <table id="biblio_table" class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Author</th>
                                <th>ISBN/ISSN</th>
                                <th>Publisher</th>
                                <th>Publication year</th>
                                <th>Framework</th>
                                <th>Deleted date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row" style="margin-top: 20px;">
        <div class="col-sm-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">Restore items</h3>
                </div>
                <div class="panel-body">
                    <table id="item_table" class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Barcode</th>
                                <th>Title</th>
                                <th>ISBN/ISSN</th>
                                <th>Location</th>
                                <th>Item type</th>
                                <th>Call number</th>
                                <th>Collection</th>
                                <th>Copy number</th>
                                <th>Deleted date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Restore biblio confirmation modal -->
    <div id="restore_biblio_modal" class="modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title">Confirm restoration</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to restore this bibliographic record?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="restore_biblio_confirm">Restore</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Restore item confirmation modal -->
    <div id="restore_item_modal" class="modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title">Confirm restoration</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to restore this item?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="restore_item_confirm">Restore</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Select items to restore modal -->
    <div id="select_items_modal" class="modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title">Select items to restore</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>This bibliographic record has the following deleted items. Select which items you want to restore:</p>
                    <div class="btn-group mb-3">
                        <button type="button" class="btn btn-sm btn-default" id="select_all_items">Select all</button>
                        <button type="button" class="btn btn-sm btn-default" id="select_none_items">Select none</button>
                    </div>
                    <table id="deleted_items_table" class="table table-striped">
                        <thead>
                            <tr>
                                <th><input type="checkbox" id="check_all_items" /></th>
                                <th>Barcode</th>
                                <th>Call number</th>
                                <th>Location</th>
                                <th>Item type</th>
                                <th>Collection</th>
                                <th>Deleted date</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="restore_biblio_with_items">Restore biblio and selected items</button>
                </div>
            </div>
        </div>
    </div>
[% END %]

[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'js_includes.inc' %]
    [% INCLUDE 'datatables.inc' %]
    <script>
        $(document).ready(function() {
            if (typeof $.fn.kohaTable === 'undefined') {
                return;
            }
            
            var biblioTable = $("#biblio_table").kohaTable({
                "serverSide": true,
                "processing": true,
                "pagingType": "full_numbers",
                "ajax": {
                    "url": "/api/v1/deleted/biblios",
                    "headers": {
                        "Accept": "application/json;charset=UTF-8"
                    },
                    "dataSrc": function(json) {
                        return Array.isArray(json) ? json : [];
                    }
                },
                "columns": [
                    { "data": "biblio_id" },
                    { "data": "title" },
                    { "data": "author" },
                    { 
                        "data": null,
                        "render": function(data, type, row) {
                            if (row.isbn) return row.isbn;
                            if (row.issn) return row.issn;
                            return '';
                        }
                    },
                    { "data": "publisher" },
                    { "data": "publication_year" },
                    { "data": "framework_id" },
                    { 
                        "data": "deleted_on",
                        "render": function(data) {
                            return data ? new Date(data).toLocaleString() : '';
                        }
                    },
                    { 
                        "data": null,
                        "orderable": false,
                        "render": function(data, type, row) {
                            return '<button class="btn btn-default btn-sm restore-biblio" data-biblionumber="' + row.biblio_id + '">Restore</button>';
                        }
                    }
                ],
                "order": [[ 7, "desc" ]],
                "language": {
                    "emptyTable": "No deleted bibliographic records found"
                },
                "dom": '<"top"<"table_entries"><"table_controls"B>>t<"bottom"<"table_entries"i><"table_controls"p>>',
                "buttons": ['clearFilter', 'copy', 'csv', 'print']
            });

            var itemTable = $("#item_table").kohaTable({
                "ajax": {
                    "url": "/api/v1/deleted/items",
                    "headers": {
                        "Accept": "application/json;charset=UTF-8"
                    },
                    "dataSrc": function(json) {
                        return Array.isArray(json) ? json : [];
                    }
                },
                "embed": "biblio",
                "serverSide": true,
                "processing": true,
                "pagingType": "full_numbers",
                "columns": [
                    { "data": "itemnumber" },
                    { "data": "barcode" },
                    { 
                        "data": "biblio",
                        "render": function(data, type, row) {
                            if (data && data.title) {
                                return data.title;
                            }
                            return "Biblio #" + row.biblionumber;
                        }
                    },
                    { 
                        "data": "biblio",
                        "render": function(data, type, row) {
                            if (data) {
                                if (data.isbn) return data.isbn;
                                if (data.issn) return data.issn;
                            }
                            return '';
                        }
                    },
                    { 
                        "data": "location",
                        "render": function(data, type, row) {
                            var location = data || row.permanent_location || '';
                            var homebranch = row.homebranch || '';
                            var holdingbranch = row.holdingbranch || '';
                            var branches = [];
                            if (homebranch) branches.push('Home: ' + homebranch);
                            if (holdingbranch && holdingbranch !== homebranch) branches.push('Holding: ' + holdingbranch);
                            return location + (branches.length ? ' (' + branches.join(', ') + ')' : '');
                        }
                    },
                    { "data": "itype" },
                    { "data": "itemcallnumber" },
                    { "data": "ccode" },
                    { "data": "copynumber" },
                    { 
                        "data": "deleted_on",
                        "render": function(data) {
                            return data ? new Date(data).toLocaleString() : '';
                        }
                    },
                    { 
                        "data": null,
                        "orderable": false,
                        "render": function(data, type, row) {
                            return '<button class="btn btn-default btn-sm restore-item" data-itemnumber="' + row.itemnumber + '">Restore</button>';
                        }
                    }
                ],
                "order": [[ 9, "desc" ]],
                "language": {
                    "emptyTable": "No deleted items found"
                },
                "dom": '<"top"<"table_entries"><"table_controls"B>>t<"bottom"<"table_entries"i><"table_controls"p>>',
                "buttons": ['clearFilter', 'copy', 'csv', 'print']
            });

            // Handle biblio restore
            var currentBiblioId = null;
            var deletedItemsTable = null;

            $("#biblio_table").on("click", ".restore-biblio", function () {
                currentBiblioId = $(this).data("biblionumber");

                // Check if there are deleted items for this biblio
                $.ajax({
                    url: "/api/v1/deleted/items?biblionumber=" + currentBiblioId,
                    method: "GET",
                    headers: {
                        Accept: "application/json;charset=UTF-8",
                    },
                    success: function (items) {
                        if (items && items.length > 0) {
                            // Show item selection modal
                            showItemSelectionModal(items);
                        } else {
                            // No deleted items, proceed with normal restoration
                            $("#restore_biblio_modal").modal("show");
                        }
                    },
                    error: function (xhr) {
                        console.error("Error checking for deleted items:", xhr);
                        // On error, proceed with normal restoration
                        $("#restore_biblio_modal").modal("show");
                    },
                });
            });

            function showItemSelectionModal(items) {
                // Initialize or clear the deleted items table
                if (deletedItemsTable) {
                    deletedItemsTable.destroy();
                }

                $("#deleted_items_table tbody").empty();

                // Populate the table with deleted items
                items.forEach(function (item) {
                    var row = $("<tr>");
                    row.append('<td><input type="checkbox" class="item-checkbox" value="' + item.itemnumber + '"></td>');
                    row.append("<td>" + (item.barcode || "") + "</td>");
                    row.append("<td>" + (item.itemcallnumber || "") + "</td>");
                    row.append("<td>" + (item.location || item.permanent_location || "") + "</td>");
                    row.append("<td>" + (item.itype || "") + "</td>");
                    row.append("<td>" + (item.ccode || "") + "</td>");
                    row.append("<td>" + (item.deleted_on ? new Date(item.deleted_on).toLocaleString() : "") + "</td>");
                    $("#deleted_items_table tbody").append(row);
                });

                // Initialize DataTable
                deletedItemsTable = $("#deleted_items_table").DataTable({
                    paging: false,
                    searching: true,
                    info: false,
                    order: [[6, "desc"]],
                });

                $("#select_items_modal").modal("show");
            }

            // Handle select all/none buttons
            $("#select_all_items").on("click", function () {
                $(".item-checkbox").prop("checked", true);
                $("#check_all_items").prop("checked", true);
            });

            $("#select_none_items").on("click", function () {
                $(".item-checkbox").prop("checked", false);
                $("#check_all_items").prop("checked", false);
            });

            // Handle check all checkbox
            $("#check_all_items").on("change", function () {
                $(".item-checkbox").prop("checked", $(this).prop("checked"));
            });

            // Handle individual checkbox changes
            $(document).on("change", ".item-checkbox", function () {
                var allChecked = $(".item-checkbox").length === $(".item-checkbox:checked").length;
                $("#check_all_items").prop("checked", allChecked);
            });

            // Handle restore biblio with selected items
            $("#restore_biblio_with_items").on("click", function () {
                var button = $(this);
                var selectedItems = [];
                $(".item-checkbox:checked").each(function () {
                    selectedItems.push($(this).val());
                });

                button.prop("disabled", true);

                // First restore the biblio
                $.ajax({
                    url: "/api/v1/restore_records/biblio/" + currentBiblioId,
                    method: "POST",
                    success: function (response) {
                        if (response.success) {
                            // Biblio restored successfully, now restore selected items
                            if (selectedItems.length > 0) {
                                restoreSelectedItems(selectedItems, button);
                            } else {
                                // No items selected, just reload and close
                                $("#biblio_table").DataTable().ajax.reload();
                                $("#item_table").DataTable().ajax.reload();
                                $("#select_items_modal").modal("hide");
                                button.prop("disabled", false);
                            }
                        } else {
                            alert("Failed to restore bibliographic record: " + (response.error || "Unknown error"));
                            button.prop("disabled", false);
                        }
                    },
                    error: function (xhr) {
                        var errorMsg = xhr.responseJSON?.error || "Unknown error";
                        alert("Error restoring bibliographic record: " + errorMsg);
                        button.prop("disabled", false);
                    },
                });
            });

            function restoreSelectedItems(itemIds, button) {
                var restored = 0;
                var errors = [];

                // Restore each selected item
                var restorePromises = itemIds.map(function (itemId) {
                    return $.ajax({
                        url: "/api/v1/restore_records/item/" + itemId,
                        method: "POST",
                    })
                        .done(function (response) {
                            if (response.success) {
                                restored++;
                            } else {
                                errors.push("Item " + itemId + ": " + (response.error || "Unknown error"));
                            }
                        })
                        .fail(function (xhr) {
                            var errorMsg = xhr.responseJSON?.error || "Unknown error";
                            errors.push("Item " + itemId + ": " + errorMsg);
                        });
                });

                // Wait for all restorations to complete
                $.when.apply($, restorePromises).always(function () {
                    if (errors.length > 0) {
                        alert("Some items could not be restored:\n" + errors.join("\n"));
                    }

                    // Reload tables and close modal
                    $("#biblio_table").DataTable().ajax.reload();
                    $("#item_table").DataTable().ajax.reload();
                    $("#select_items_modal").modal("hide");
                    button.prop("disabled", false);

                    // Successfully restored items - no console logging needed
                });
            }

            $("#restore_biblio_confirm").on("click", function () {
                var button = $(this);
                button.prop('disabled', true);

                $.ajax({
                    url: '/api/v1/restore_records/biblio/' + currentBiblioId,
                    method: 'POST',
                    success: function(response) {
                        if (response.success) {
                            $("#biblio_table").DataTable().ajax.reload();
                            $('#restore_biblio_modal').modal('hide');
                        } else {
                            alert('Failed to restore bibliographic record: ' + (response.error || 'Unknown error'));
                        }
                    },
                    error: function(xhr) {
                        var errorMsg = xhr.responseJSON?.error || 'Unknown error';
                        alert('Error restoring bibliographic record: ' + errorMsg);
                    },
                    complete: function() {
                        button.prop('disabled', false);
                    }
                });
            });

            // Handle item restore
            var currentItemId = null;
            $('#item_table').on('click', '.restore-item', function() {
                currentItemId = $(this).data('itemnumber');
                $('#restore_item_modal').modal('show');
            });

            $('#restore_item_confirm').on('click', function() {
                var button = $(this);
                button.prop('disabled', true);

                $.ajax({
                    url: '/api/v1/restore_records/item/' + currentItemId,
                    method: 'POST',
                    success: function(response) {
                        if (response.success) {
                            $("#item_table").DataTable().ajax.reload();
                            $('#restore_item_modal').modal('hide');
                        } else {
                            alert('Failed to restore item: ' + (response.error || 'Unknown error'));
                        }
                    },
                    error: function(xhr) {
                        var errorMsg = xhr.responseJSON?.error || 'Unknown error';
                        alert('Error restoring item: ' + errorMsg);
                    },
                    complete: function() {
                        button.prop('disabled', false);
                    }
                });
            });
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %] 
