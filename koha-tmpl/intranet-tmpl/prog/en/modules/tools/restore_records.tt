[% INCLUDE 'doc-head-open.inc' %]
<title>Restore Records &rsaquo; Tools &rsaquo; Koha</title>
[% INCLUDE 'doc-head-close.inc' %]
[% INCLUDE 'calendar.inc' %]
[% INCLUDE 'datatables.inc' %]
<link rel="stylesheet" type="text/css" href="[% interface %]/[% theme %]/css/datatables.css" />
<script type="text/javascript">
//<![CDATA[
$(document).ready(function() {
    var recordsTable = $("#records-table").DataTable({
        "autoWidth": false,
        "columnDefs": [
            { "targets": [0], "orderable": false, "searchable": false },
            { "targets": [1], "type": "num" },
            { "targets": [2,3,4,5,6], "type": "string" },
            { "targets": [7], "type": "date" }
        ],
        "language": {
            "search": "Filter:"
        }
    });

    var itemsTable = $("#items-table").DataTable({
        "autoWidth": false,
        "columnDefs": [
            { "targets": [0], "orderable": false, "searchable": false },
            { "targets": [1,2,7], "type": "num" },
            { "targets": [3,4,5,6], "type": "string" },
            { "targets": [8], "type": "date" }
        ],
        "language": {
            "search": "Filter:"
        }
    });

    $("#search-form").on("submit", function(e) {
        e.preventDefault();
        var type = $("input[name='type']:checked").val();
        var fromDate = $("#from-date").val();
        var toDate = $("#to-date").val();

        $.ajax({
            url: "/api/v1/restore_records/search",
            method: "GET",
            data: {
                type: type,
                from_date: fromDate,
                to_date: toDate
            },
            success: function(data) {
                if (type === "records") {
                    recordsTable.clear();
                    recordsTable.rows.add(data.records);
                    recordsTable.draw();
                } else {
                    itemsTable.clear();
                    itemsTable.rows.add(data.items);
                    itemsTable.draw();
                }
            },
            error: function(xhr) {
                alert("Error searching records: " + xhr.responseJSON.error);
            }
        });
    });

    $("#restore-selected").on("click", function() {
        var type = $("input[name='type']:checked").val();
        var selected = [];

        if (type === "records") {
            $("input[name='record_id']:checked").each(function() {
                selected.push($(this).val());
            });
        } else {
            $("input[name='item_id']:checked").each(function() {
                selected.push($(this).val());
            });
        }

        if (selected.length === 0) {
            alert("Please select at least one record to restore");
            return;
        }

        if (!confirm("Are you sure you want to restore the selected " + type + "?")) {
            return;
        }

        var endpoint = type === "records" ? "/api/v1/restore_records/biblio/" : "/api/v1/restore_records/item/";
        var successCount = 0;
        var errorCount = 0;

        selected.forEach(function(id) {
            $.ajax({
                url: endpoint + id,
                method: "POST",
                success: function() {
                    successCount++;
                    if (successCount + errorCount === selected.length) {
                        alert(successCount + " " + type + " restored successfully" +
                              (errorCount > 0 ? "\n" + errorCount + " failed" : ""));
                        $("#search-form").submit();
                    }
                },
                error: function(xhr) {
                    errorCount++;
                    if (successCount + errorCount === selected.length) {
                        alert(successCount + " " + type + " restored successfully" +
                              (errorCount > 0 ? "\n" + errorCount + " failed" : ""));
                        $("#search-form").submit();
                    }
                }
            });
        });
    });
});
//]]>
</script>
</head>
<body id="tools_restore_records" class="tools">
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="breadcrumbs"><a href="/cgi-bin/koha/mainpage.pl">Home</a> &rsaquo; <a href="/cgi-bin/koha/tools/tools-home.pl">Tools</a> &rsaquo; Restore Records</div>

<div class="main container-fluid">
    <div class="row">
        <div class="col-sm-10 col-sm-push-2">
            <main>
                <h1>Restore Records</h1>

                <div class="row">
                    <div class="col-sm-6">
                        <form id="search-form" class="validated">
                            <fieldset class="rows">
                                <legend>Search deleted records</legend>
                                <ol>
                                    <li>
                                        <label>Type:</label>
                                        <div class="radio">
                                            <label>
                                                <input type="radio" name="type" value="records" checked="checked" />
                                                Bibliographic records
                                            </label>
                                        </div>
                                        <div class="radio">
                                            <label>
                                                <input type="radio" name="type" value="items" />
                                                Items
                                            </label>
                                        </div>
                                    </li>
                                    <li>
                                        <label for="from-date">From date:</label>
                                        <input type="text" id="from-date" name="from_date" class="datepicker" />
                                    </li>
                                    <li>
                                        <label for="to-date">To date:</label>
                                        <input type="text" id="to-date" name="to_date" class="datepicker" />
                                    </li>
                                </ol>
                            </fieldset>
                            <fieldset class="action">
                                <input type="submit" value="Search" class="btn btn-primary" />
                            </fieldset>
                        </form>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12">
                        <div id="records-results" style="display: none;">
                            <h2>Deleted Bibliographic Records</h2>
                            <table id="records-table" class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th><input type="checkbox" id="select-all-records" /></th>
                                        <th>Biblionumber</th>
                                        <th>Author</th>
                                        <th>Title</th>
                                        <th>ISBN</th>
                                        <th>ISSN</th>
                                        <th>Date created</th>
                                        <th>Date deleted</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>

                        <div id="items-results" style="display: none;">
                            <h2>Deleted Items</h2>
                            <table id="items-table" class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th><input type="checkbox" id="select-all-items" /></th>
                                        <th>Item number</th>
                                        <th>Barcode</th>
                                        <th>Biblionumber</th>
                                        <th>Title</th>
                                        <th>Author</th>
                                        <th>ISBN</th>
                                        <th>ISSN</th>
                                        <th>Date deleted</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>

                        <div class="action-buttons">
                            <button id="restore-selected" class="btn btn-default">Restore selected</button>
                        </div>
                    </div>
                </div>
            </main>
        </div>
        <div class="col-sm-2 col-sm-pull-10">
            <aside>
                [% INCLUDE 'tools-menu.inc' %]
            </aside>
        </div>
    </div>
</div>

[% INCLUDE 'intranet-bottom.inc' %]