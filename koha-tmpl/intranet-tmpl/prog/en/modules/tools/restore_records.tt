[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% USE KohaDates %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% FILTER collapse %]
    [% t("Restore records") | html %]
    &rsaquo; [% t("Tools") | html %] &rsaquo; [% t("Koha") | html %]
[% END %]</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="tools_restore_records" class="tools">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'cat-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/tools/tools-home.pl">Tools</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            <span>Restore records</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' aside='tools-menu' %]
    <h1>Restore records</h1>

    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">Restore bibliographic records</h3>
                </div>
                <div class="panel-body">
                    <table id="biblio_table" class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Author</th>
                                <th>ISBN/ISSN</th>
                                <th>Publisher</th>
                                <th>Publication year</th>
                                <th>Framework</th>
                                <th>Deleted date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row" style="margin-top: 20px;">
        <div class="col-sm-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">Restore items</h3>
                </div>
                <div class="panel-body">
                    <table id="item_table" class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Barcode</th>
                                <th>Title</th>
                                <th>ISBN/ISSN</th>
                                <th>Location</th>
                                <th>Item type</th>
                                <th>Call number</th>
                                <th>Collection</th>
                                <th>Copy number</th>
                                <th>Deleted date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
[% END %]

[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'js_includes.inc' %]
    [% INCLUDE 'datatables.inc' %]
    <script>
        $(document).ready(function() {
            if (typeof $.fn.kohaTable === 'undefined') {
                return;
            }
            
            // Initialize tables
            $("#biblio_table").kohaTable({
                "ajax": {
                    "url": "/api/v1/deleted/biblios",
                    "headers": {
                        "Accept": "application/json;charset=UTF-8"
                    },
                    "data": function(d) {
                        return {
                            _page: (d.start / d.length) + 1,
                            _per_page: d.length,
                            _order_by: d.order ? d.order.map(function(order) {
                                return d.columns[order.column].data + " " + order.dir;
                            }) : []
                        };
                    },
                    "beforeSend": function(xhr) {
                        xhr.setRequestHeader("Accept", "application/json;charset=UTF-8");
                    },
                    "dataSrc": function(json) {
                        return Array.isArray(json) ? json : [];
                    }
                },
                "columns": [
                    { "data": "biblio_id" },
                    { "data": "title" },
                    { "data": "author" },
                    { 
                        "data": null,
                        "render": function(data, type, row) {
                            if (row.isbn) return row.isbn;
                            if (row.issn) return row.issn;
                            return '';
                        }
                    },
                    { "data": "publisher" },
                    { "data": "publication_year" },
                    { "data": "framework_id" },
                    { 
                        "data": "deleted_on",
                        "render": function(data) {
                            return data ? new Date(data).toLocaleString() : '';
                        }
                    },
                    { 
                        "data": null,
                        "orderable": false,
                        "render": function(data, type, row) {
                            return '<button class="btn btn-default btn-sm restore-biblio" data-biblionumber="' + row.biblio_id + '">Restore</button>';
                        }
                    }
                ],
                "order": [[ 0, "desc" ]],
                "language": {
                    "emptyTable": "No deleted bibliographic records found"
                },
                "dom": '<"top"<"table_entries"><"table_controls"fB>>t<"bottom"<"table_entries"i><"table_controls"p>>',
                "buttons": ['clearFilter', 'copy', 'csv', 'print']
            });

            $("#item_table").kohaTable({
                "ajax": {
                    "url": "/api/v1/deleted/items",
                    "headers": {
                        "Accept": "application/json;charset=UTF-8"
                    },
                    "dataSrc": function(json) {
                        return Array.isArray(json) ? json : [];
                    }
                },
                "embed": "biblio",
                "columns": [
                    { "data": "itemnumber" },
                    { "data": "barcode" },
                    { 
                        "data": "biblio",
                        "render": function(data, type, row) {
                            if (data && data.title) {
                                return data.title;
                            }
                            return "Biblio #" + row.biblionumber;
                        }
                    },
                    { 
                        "data": "biblio",
                        "render": function(data, type, row) {
                            if (data) {
                                if (data.isbn) return data.isbn;
                                if (data.issn) return data.issn;
                            }
                            return '';
                        }
                    },
                    { 
                        "data": "location",
                        "render": function(data, type, row) {
                            var location = data || row.permanent_location || '';
                            var homebranch = row.homebranch || '';
                            var holdingbranch = row.holdingbranch || '';
                            var branches = [];
                            if (homebranch) branches.push('Home: ' + homebranch);
                            if (holdingbranch && holdingbranch !== homebranch) branches.push('Holding: ' + holdingbranch);
                            return location + (branches.length ? ' (' + branches.join(', ') + ')' : '');
                        }
                    },
                    { "data": "itype" },
                    { "data": "itemcallnumber" },
                    { "data": "ccode" },
                    { "data": "copynumber" },
                    { 
                        "data": "deleted_on",
                        "render": function(data) {
                            return data ? new Date(data).toLocaleString() : '';
                        }
                    },
                    { 
                        "data": null,
                        "orderable": false,
                        "render": function(data, type, row) {
                            return '<button class="btn btn-default btn-sm restore-item" data-itemnumber="' + row.itemnumber + '">Restore</button>';
                        }
                    }
                ],
                "order": [[ 0, "desc" ]],
                "language": {
                    "emptyTable": "No deleted items found"
                },
                "dom": '<"top"<"table_entries"><"table_controls"fB>>t<"bottom"<"table_entries"i><"table_controls"p>>',
                "buttons": ['clearFilter', 'copy', 'csv', 'print']
            });
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %] 